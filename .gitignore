# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/

# Data and model artifacts are reproducible from code; keep them out of git
data/*
# ...except the test set: an LLM can't reproduce it exactly, and it took ~3 h to make
!data/eval/
data/eval/*
!data/eval/queries.jsonl
!data/eval/labels.json
!data/eval/split.json
# ...and graded labels: neither an LLM nor a person grades exactly the same way twice
!data/eval/judgments/
!data/eval/judge_pilot/
# ...and the results of every experiment (small; the results table is rebuilt from them)
!data/results/

# Secrets
.env
*.log
